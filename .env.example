# =====================================================================
# PushBridge Environment Configuration Template (v3.0.3)
# =====================================================================
# Copy this file to .env and customize with your private project settings.
# Do NOT commit .env or private key files to git.

PORT=3000
NODE_ENV=development

# 1. Firebase Project Credentials
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_API_KEY=your_firebase_web_api_key_here
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id

# 2. Service Account Credentials (required for relay-server admin sync)
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 3. Client & Companion Shared Secret Authentication
PUSHBRIDGE_SYNC_SECRET=your_secure_random_token_here

# 4. Telephony & SMS Sync Pagination Defaults
DEFAULT_SMS_PAGINATION_LIMIT=30
MAX_SMS_MESSAGES_PER_THREAD=100
