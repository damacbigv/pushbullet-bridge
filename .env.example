# =====================================================================
# PushBridge Environment Configuration Template (v3.0.2)
# =====================================================================
# Copy this file to .env and customize with your private project settings.
# Do NOT commit .env or private key files to git.

PORT=3000
NODE_ENV=development

# 1. Firebase Project Credentials
FIREBASE_PROJECT_ID=pushclonebridge
FIREBASE_DATABASE_URL=https://pushclonebridge-default-rtdb.firebaseio.com
FIREBASE_API_KEY=AIzaSyCmoxdDpdYz_Gxsx04zXSemus6fJmA4-gU
FIREBASE_STORAGE_BUCKET=pushclonebridge.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=250338142494
FIREBASE_APP_ID=1:250338142494:web:5029dbee8c1e9da606810f

# 2. Service Account Credentials (required for relay-server admin sync)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# 3. Client & Companion Shared Secret Authentication
PUSHBRIDGE_SYNC_SECRET=pushbridge_dev_secret_token

# 4. Telephony & SMS Sync Pagination Defaults
DEFAULT_SMS_PAGINATION_LIMIT=30
MAX_SMS_MESSAGES_PER_THREAD=100
