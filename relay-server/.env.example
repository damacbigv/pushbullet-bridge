PORT=3000
NODE_ENV=development

# Firebase Project Configuration
FIREBASE_PROJECT_ID=pushclonebridge
FIREBASE_DATABASE_URL=https://pushclonebridge-default-rtdb.firebaseio.com

# Service Account credentials (optional for local mock dev, required for cloud sync)
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@pushclonebridge.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Shared authentication secret between paired clients
PUSHBRIDGE_SYNC_SECRET=pushbridge_dev_secret_token
